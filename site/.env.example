# PostgreSQL connection string (Neon, Supabase, etc.)
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-random-32-char-string"
NEXTAUTH_URL="http://localhost:3000"

# Netlify Blobs — auto-injected on Netlify; for local dev these are optional
# NETLIFY_SITE_ID=
# NETLIFY_AUTH_TOKEN=

# Telegram contact form (existing) — admin notification chat
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Telegram bot deep-link & webhook (new)
# Bot username WITHOUT the @ sign (e.g. SQBAIBot)
TELEGRAM_BOT_USERNAME=""
# Random secret to verify webhook requests from Telegram (generate: openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=""

# After deploying, register the webhook once:
#   curl -X POST "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#        -d "url=https://yourdomain.com/api/telegram/webhook" \
#        -d "secret_token=<TELEGRAM_WEBHOOK_SECRET>"
